# Ziad E-commerce — API (apps/api)
# ---------------------------------------------------------------------------
# The API reads the repository root `.env` automatically (see src/app.module.ts,
# envFilePath: ../../.env). Alternatively copy this file to `.env` inside this
# directory. Never commit the real `.env` file.

# HTTP port the API listens on.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (Supabase hosted database or local Postgres).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local development example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ziad_dev
DATABASE_URL=

# Comma-separated list of allowed browser origins (CORS).
# Phase 23: production MUST be an explicit allowlist (no "*"); the API refuses
# to boot in production with a wildcard or an empty CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000

# Phase 23 — trust the reverse proxy's forwarding headers so rate limiting sees
# the real client IP. Set 1 (or the proxy address/subnet) when the API is
# behind a CDN / load balancer; leave empty when directly exposed.
TRUST_PROXY=

# Phase 23 — send Strict-Transport-Security. ONLY enable on an HTTPS-terminated
# production deployment (never over plain HTTP).
SECURITY_HSTS_ENABLED=false

# Free-trial duration in days (SaaS Subscription phase — BRD BR-SUB-001: the
# exact duration is a product decision and MUST be configured, not hard-coded).
SUBSCRIPTION_TRIAL_DAYS=14

# Supabase platform settings (consumed from the Authentication phase onward).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for media binaries (Media phase). Optional at boot;
# the media storage provider FAILS CLOSED when the bucket or credentials are
# missing.
SUPABASE_STORAGE_BUCKET=media

# Public storefront platform domain (DATABASE.md §7.2 — the MVP storefront URL
# is `store-slug.platform-domain.com`). Used to resolve the Store from the
# public storefront Host header subdomain; `X-Storefront-Slug` also works.
STOREFRONT_DOMAIN=platform-domain.com

# Phase 21/23 — PostgreSQL role applied with `SET LOCAL ROLE` inside every
# tenant-bound transaction so RLS policies are ENFORCED for the application
# connection. Combine with migration 20260814000000_rls_enforcement and a
# DATABASE_URL whose user is a member of `ziad_runtime`. Leave empty to keep
# the owner-connection behavior (not production-safe).
RLS_ENFORCEMENT_ROLE=

# Phase 23 — distributed lease lifetime (ms) for the reservation/cart expiry
# sweep (job_leases). Multi-instance safe; see IMPLEMENTATION-PHASE23.
RESERVATION_EXPIRY_LEASE_TTL_MS=600000

# ── Phase 25 — production performance knobs ──────────────────────────────────
# Short-TTL in-memory caches that remove per-request Supabase/database
# round-trips from hot paths. All default to 60s. Set a value to 0 to disable
# that cache entirely. Multi-instance deployments each hold their own cache
# (no shared store) — the TTL keeps staleness bounded regardless of instance
# count. See the Phase 25 performance report for the exact trade-offs.
AUTH_VERIFY_CACHE_TTL_MS=60000
TENANT_RESOLUTION_CACHE_TTL_MS=60000
STOREFRONT_RESOLUTION_CACHE_TTL_MS=60000

# ── Paymob Accept (Payments phase) — https://accept.paymob.com ──────────────
# All values are optional at boot; the payment provider FAILS CLOSED when the
# credentials needed for an operation are missing. Never commit real secrets.
# Phase 22/24: the provider uses the Intention API + Unified Checkout; the iframe
# id is no longer required. Phase 24: PAYMOB_API_KEY must be the NEW-format Paymob
# SECRET KEY (egy_sk_test_.../egy_sk_live_...); the legacy JWT API key is rejected
# by the Intention API (401).
# Paymob Accept API base URL (leave empty to use https://accept.paymob.com).
PAYMOB_API_URL=
# NEW-format Paymob Secret Key used to authenticate the Intention API.
PAYMOB_API_KEY=
# Authorization scheme: Bearer (default) or Token (Paymob's published docs).
PAYMOB_AUTH_SCHEME=Bearer
# Payment integration id for the payment key request.
PAYMOB_INTEGRATION_ID=
# Public key used to open the Unified Checkout URL (NOT a secret).
PAYMOB_PUBLIC_KEY=
# (OPTIONAL, legacy) Hosted iframe id — no longer required.
PAYMOB_IFRAME_ID=
# HMAC secret used to verify Paymob transaction-process webhook callbacks.
PAYMOB_HMAC_SECRET=
# Optional full webhook URL sent as notification_url on every Intention.
PAYMOB_WEBHOOK_URL=
