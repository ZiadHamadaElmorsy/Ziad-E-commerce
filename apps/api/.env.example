# Ziad E-commerce — API (apps/api)
# ---------------------------------------------------------------------------
# The API reads the repository root `.env` automatically (see src/app.module.ts,
# envFilePath: ../../.env). Alternatively copy this file to `.env` inside this
# directory. Never commit the real `.env` file.

# HTTP port the API listens on.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (Supabase hosted database or local Postgres).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local development example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ziad_dev
DATABASE_URL=

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Supabase platform settings (consumed from the Authentication phase onward).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
