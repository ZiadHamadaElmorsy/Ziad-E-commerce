# Ziad E-commerce — web (apps/web)
# ---------------------------------------------------------------------------
# Copy this file to `.env` inside this directory and adjust the values.
# Never commit the real `.env` file (it is ignored via .gitignore).

# Base URL of the NestJS API. Must include the /api/v1 prefix.
# Phase 23 (production): https://api.yourdomain.com/api/v1
# PRODUCTION REQUIREMENT (next.config.ts fails the build without it):
#   - MUST be an https:// URL (never http://localhost in production).
#   - MUST end with /api/v1 — the NestJS API only serves under the api/v1
#     global prefix (e.g. https://ziad-e-commerce-api.onrender.com/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public storefront platform domain — `{storeSlug}.{STOREFRONT_DOMAIN}` in
# production. The Next.js middleware (proxy.ts) rewrites storefront
# subdomains to /store/[slug]; the API uses its own STOREFRONT_DOMAIN for the
# authoritative store resolution. Leave as platform-domain.com for local dev.
STOREFRONT_DOMAIN=platform-domain.com

# Phase 23 — web Strict-Transport-Security. ONLY enable on an HTTPS-terminated
# production deployment (never over plain HTTP).
SECURITY_HSTS_ENABLED=false

# Supabase project settings -> API -> Project URL.
# PRODUCTION REQUIREMENT (next.config.ts fails the build without it): set the
# REAL project URL in the Vercel Production environment and redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase project settings -> API -> anon public key.
# The anon key is public (safe for browser bundles); it is NOT a secret.
# PRODUCTION REQUIREMENT (next.config.ts fails the build without it): set the
# REAL anon key in the Vercel Production environment and redeploy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
