# Ziad E-commerce — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values.
# Never commit the real `.env` file (it is ignored via .gitignore).
#
# The API (apps/api) reads this root `.env` automatically.
# The web app (apps/web) reads its own `apps/web/.env` — copy
# `apps/web/.env.example` there when frontend variables are needed.

# ── API — apps/api ─────────────────────────────────────────────────────
# Port the NestJS API listens on.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (Supabase hosted database or local Postgres).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Public storefront platform domain (DATABASE.md §7.2 — the MVP storefront URL
# is `store-slug.platform-domain.com`). Used to resolve the Store from the
# public storefront Host header subdomain; `X-Storefront-Slug` also works.
STOREFRONT_DOMAIN=platform-domain.com

# Free-trial duration in days (SaaS Subscription phase — BRD BR-SUB-001: the
# exact duration is a product decision and MUST be configured, not hard-coded).
# Applies to the trial subscription row created with every new Store.
SUBSCRIPTION_TRIAL_DAYS=14

# ── Supabase platform (used from the Authentication phase onward) ──────
# Supabase project settings -> API -> Project URL / keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for media binaries (Media phase). Optional at boot;
# the media storage provider FAILS CLOSED when the bucket or credentials are
# missing. Never commit real secrets.
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Paymob Accept (Payments phase) — https://accept.paymob.com
# All values are optional at boot; the payment provider FAILS CLOSED when the
# credentials needed for an operation are missing. Never commit real secrets.
# ---------------------------------------------------------------------------
# Paymob Accept API base URL (leave empty to use https://accept.paymob.com).
PAYMOB_API_URL=
# Secret API key used to obtain the auth token (Paymob Dashboard -> Account).
PAYMOB_API_KEY=
# Payment integration id for the payment key request.
PAYMOB_INTEGRATION_ID=
# Hosted iframe id rendered by the storefront to collect the card details.
PAYMOB_IFRAME_ID=
# HMAC secret used to verify Paymob transaction-process webhook callbacks.
PAYMOB_HMAC_SECRET=

# ── Web — apps/web ─────────────────────────────────────────────────────
# Base URL of the API. Must include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase project settings -> API -> Project URL / anon public key.
# Used by the admin dashboard for the real login/session flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
