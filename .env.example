# Ziad E-commerce — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values.
# Never commit the real `.env` file (it is ignored via .gitignore).
#
# The API (apps/api) reads this root `.env` automatically.
# The web app (apps/web) reads its own `apps/web/.env` — copy
# `apps/web/.env.example` there when frontend variables are needed.

# ── API — apps/api ─────────────────────────────────────────────────────
# Port the NestJS API listens on.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string (Supabase hosted database or local Postgres).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Comma-separated list of allowed browser origins (CORS).
# Phase 23: production MUST be an explicit allowlist (no "*"); the API refuses
# to boot in production with a wildcard or an empty CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000

# Phase 23 — trust the reverse proxy's forwarding headers so rate limiting sees
# the real client IP. Set 1 (or the proxy address/subnet) when the API is
# behind a CDN / load balancer; leave empty when directly exposed.
TRUST_PROXY=

# Phase 23 — send Strict-Transport-Security. ONLY enable on an HTTPS-terminated
# production deployment (never over plain HTTP).
SECURITY_HSTS_ENABLED=false

# Public storefront platform domain (DATABASE.md §7.2 — the MVP storefront URL
# is `store-slug.platform-domain.com`). Used to resolve the Store from the
# public storefront Host header subdomain; `X-Storefront-Slug` also works.
# Phase 21: in production set this to your real apex domain (e.g. yourdomain.com)
# and configure a wildcard DNS record + wildcard TLS certificate.
STOREFRONT_DOMAIN=platform-domain.com

# Phase 21 — accept wildcard-subdomain storefront requests via the Host header.
# Default: enabled in production, disabled elsewhere (localhost dev uses
# X-Storefront-Slug through the /store/[slug] route).
STOREFRONT_HOST_RESOLUTION_ENABLED=

# Phase 21 — PostgreSQL role applied with `SET LOCAL ROLE` inside every
# tenant-bound transaction so RLS policies are ENFORCED for the application
# connection (combine with the 20260814000000_rls_enforcement migration and a
# DATABASE_URL that connects as this role). Leave empty to keep the current
# owner-connection behavior.
RLS_ENFORCEMENT_ROLE=

# Free-trial duration in days (SaaS Subscription phase — BRD BR-SUB-001: the
# exact duration is a product decision and MUST be configured, not hard-coded).
# Applies to the trial subscription row created with every new Store.
SUBSCRIPTION_TRIAL_DAYS=14

# ── Supabase platform (used from the Authentication phase onward) ──────
# Supabase project settings -> API -> Project URL / keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for media binaries (Media phase). Optional at boot;
# the media storage provider FAILS CLOSED when the bucket or credentials are
# missing. Never commit real secrets.
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Phase 21 — production hardening (rate limiting, expiry, media limits)
# ---------------------------------------------------------------------------
# Master switch for the global rate limiter (default enabled outside test).
RATE_LIMIT_ENABLED=
# Sliding-window size and default per-IP limit (per window).
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_LIMIT=300
# Per-bucket per-IP limits (same window).
RATE_LIMIT_AUTH_LIMIT=60
RATE_LIMIT_STOREFRONT_READ_LIMIT=120
RATE_LIMIT_CART_LIMIT=60
RATE_LIMIT_CHECKOUT_LIMIT=30
RATE_LIMIT_PAYMENT_LIMIT=30
RATE_LIMIT_ORDER_LOOKUP_LIMIT=60
RATE_LIMIT_MEDIA_LIMIT=300
RATE_LIMIT_WEBHOOK_LIMIT=120
RATE_LIMIT_MERCHANT_API_LIMIT=300

# Abandoned-cart / inventory-reservation expiry.
# Carts expire CART_TTL_MS after creation; reservations set at checkout expire
# RESERVATION_TTL_MS later and are released by the periodic sweep.
CART_TTL_MS=604800000
RESERVATION_TTL_MS=1800000
RESERVATION_EXPIRY_ENABLED=
RESERVATION_EXPIRY_INTERVAL_MS=300000
RESERVATION_EXPIRY_BATCH_SIZE=100
# Phase 23 — distributed lease lifetime for the expiry sweep (job_leases). In a
# multi-instance deployment at most ONE node sweeps at a time; a crashed node's
# lease expires after this TTL so the sweep can never be blocked.
RESERVATION_EXPIRY_LEASE_TTL_MS=600000

# Phase 28 — payment-event retry/reprocessing sweep (F-3). RECEIVED/ERROR
# payment_events rows are re-applied through the guarded idempotent webhook
# processor so a transient webhook failure can never leave a paid order
# unconfirmed. Lease-coordinated on job_leases like the expiry sweep.
PAYMENT_RETRY_ENABLED=
PAYMENT_RETRY_INTERVAL_MS=300000
PAYMENT_RETRY_BATCH_SIZE=20
PAYMENT_RETRY_LEASE_TTL_MS=600000

# Media upload security.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

# ---------------------------------------------------------------------------
# Paymob Accept (Payments phase) — https://accept.paymob.com
# All values are optional at boot; the payment provider FAILS CLOSED when the
# credentials needed for an operation are missing. Never commit real secrets.
# Phase 21: production requires REAL values for the PAYMOB_* credentials;
# placeholder-shaped values (YOUR-... / REPLACE / placeholder) are treated as
# missing by the startup diagnostic.
# Phase 22/24: the provider uses the CURRENT Paymob Intention API + Unified
# Checkout. PAYMOB_IFRAME_ID is NO LONGER REQUIRED (the dashboard Iframes page
# is not used) and may be removed from your environment.
# Phase 24 (authentication contract): the Intention API requires the NEW-format
# Paymob SECRET KEY (Settings -> API Keys -> Secret Key, e.g. egy_sk_test_...)
# in PAYMOB_API_KEY. The legacy JWT API key (starts with eyJ.../ZXl...) only
# authenticates the legacy endpoints and the Intention API rejects it with 401.
# ---------------------------------------------------------------------------
# Paymob Accept API base URL (leave empty to use https://accept.paymob.com).
PAYMOB_API_URL=
# NEW-format Paymob Secret Key (egy_sk_test_.../egy_sk_live_...). Authenticates
# the Intention API via the Authorization header. NOT the legacy JWT API key.
PAYMOB_API_KEY=
# Authorization scheme for the Intention API: Bearer (default, matches the live
# endpoint's WWW-Authenticate) or Token (Paymob's published docs).
PAYMOB_AUTH_SCHEME=Bearer
# Payment integration id for the payment key request.
PAYMOB_INTEGRATION_ID=
# (OPTIONAL, legacy) Hosted iframe id — no longer required for the Intention flow.
PAYMOB_IFRAME_ID=
# Public key (Paymob Dashboard -> Account -> public key). NOT a secret. Required
# to open the hosted Unified Checkout URL.
PAYMOB_PUBLIC_KEY=
# HMAC secret used to verify Paymob transaction-process webhook callbacks.
PAYMOB_HMAC_SECRET=
# OPTIONAL full public URL of the Paymob webhook endpoint, e.g.
# https://api.yourdomain.com/api/v1/webhooks/paymob. Sent as notification_url on
# every Intention so callbacks reach the API even without dashboard config.
PAYMOB_WEBHOOK_URL=

# ── Web — apps/web ─────────────────────────────────────────────────────
# Base URL of the API. Must include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical public origin of the web app — used to build authentication
# redirect URLs (the Supabase email-confirmation link after signup).
#   Local development: http://localhost:3000
#   Production:        https://ziad-e-commerce-web-sigma.vercel.app
# Production emails must NEVER redirect to localhost, so next.config.ts fails
# the production build when this is missing or not https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public support phone number shown on the auth screens. Public by design.
# Replace the placeholder with the merchant's real support number.
NEXT_PUBLIC_SUPPORT_PHONE=+20 100 000 0000

# Supabase project settings -> API -> Project URL / anon public key.
# Used by the admin dashboard for the real login/session flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
